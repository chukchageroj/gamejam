[gd_scene format=3 uid="uid://b6ie8l6hc1o75"]

[ext_resource type="Script" path="res://scenes/transition_screen.gd" id="1_12c8c"]

[sub_resource type="GDScript" id="GDScript_jweab"]
script/source = "extends Node

signal on_transition_finished

@onready var color_rect = find_child(\"ColorRect\", true, false)
@onready var animation_player = find_child(\"AnimationPlayer\", true, false)

func _ready():
	color_rect.visible = false
	animation_player.animation_finished.connect(_on_animation_finished)
	

func _on_animation_finished(animation_name):
	if animation_name == \"fade_from_checkpoint\":
		on_transition_finished.emit()
		animation_player.play(\"fade_out_from_memory\")
	elif animation_name == \"fade_out_from_memory\":
		color_rect.visible = false
		
		


func transition():
	color_rect.visible = true
	animation_player.play(\"fade_from_checkpoint\")
"

