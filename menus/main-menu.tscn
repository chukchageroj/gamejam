[sub_resource type="GDScript" id="GDScript_hf3n6"]
script/source = "extends Control

@onready var PopUpWindow = $Window

@onready var main_buttons: VBoxContainer = $MainButtons
@onready var settings: Panel = $Settings

const THEME_MUSIC = preload(\"res://audio/MissUp_theme.ogg\")

func _ready() -> void:
	AudioController.play_music(THEME_MUSIC, true)
	main_buttons.visible = true
	settings.visible = false
	PopUpWindow.hide()

# Called every frame. 'delta' is the elapsed time since the previous frame.
@warning_ignore(\"unused_parameter\")
func _process(delta: float) -> void:
	pass

#Start, settings -> transition to another scene
func _on_start_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/flashbacks/tutorial.tscn\")

func _on_settings_2_pressed() -> void:
	main_buttons.visible = false
	settings.visible = true

func _on_exit_pressed() -> void:
	main_buttons.visible = false
	PopUpWindow.show()

func _on_yes_button_pressed() -> void:
	get_tree().quit()

func _on_cross_icon_button_pressed() -> void:
	settings.visible = false
	main_buttons.visible = true

func _on_no_button_pressed() -> void:
	PopUpWindow.hide()
	main_buttons.visible = true


func _on_start_mouse_entered() -> void:
	AudioController.play_sfx(preload(\"res://audio/sfx.wav\"))


func _on_options_mouse_entered() -> void:
	AudioController.play_sfx(preload(\"res://audio/sfx.wav\"))


func _on_quit_mouse_entered() -> void:
	AudioController.play_sfx(preload(\"res://audio/sfx.wav\"))


func _on_no_button_mouse_entered() -> void:
	AudioController.play_sfx(preload(\"res://audio/sfx.wav\"))


func _on_yes_button_mouse_entered() -> void:
	AudioController.play_sfx(preload(\"res://audio/sfx.wav\"))


func _on_full_screen_control_mouse_entered() -> void:
	AudioController.play_sfx(preload(\"res://audio/sfx.wav\"))
"

